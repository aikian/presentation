server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # index.html은 캐시하지 않는다. Cache-Control이 없으면 브라우저가 휴리스틱으로
    # 캐시해서, 배포 후에도 사용자가 옛 화면(옛 번들)을 보며 "로그인이 안 된다"가 된다.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    # 번들은 파일명에 해시가 붙으므로 영구 캐시해도 안전하다. 내용이 바뀌면 이름이 바뀐다.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
