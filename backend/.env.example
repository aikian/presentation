# Gemini (AI 코칭). 무료 등급이면 gemini-flash-lite-latest 가 하루 한도가 넉넉하다.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# 업로드와 프레임 추출
UPLOAD_DIR=uploads
STATIC_DIR=static
MAX_UPLOAD_SIZE_MB=95
FRAME_INTERVAL_SEC=2
# 분석 전 프레임 긴 변 크기(px). 0이면 원본 유지(기본). 낮은 사양 서버에서 640 으로 켜서 쓴다.
MAX_FRAME_SIDE=0

# 음성 분석. WHISPER_MODEL 은 tiny/base/small/medium 중 하나.
ENABLE_AUDIO_ANALYSIS=true
WHISPER_MODEL=small

# 인증. SECRET_KEY는 32자 이상 임의 문자열. 기본값이면 서버가 뜨지 않는다.
# 생성 예) python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-random-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Supabase. 키는 eyJ 로 시작하는 Legacy API keys 값을 쓴다 (sb_ 로 시작하는 새 형식은 안 됨).
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 게시판 영상 저장 버킷과 크기 제한
BOARD_VIDEO_BUCKET=presentation-videos
BOARD_MAX_VIDEO_MB=50

# 성장 피드백에 AI 호출을 쓸지 여부
GROWTH_AI_ENABLED=true

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend-domain.com
