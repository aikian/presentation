    "silence_filler_penalty_weight": 2.0,
    "extra_silence_penalty": 0.5, 
    "silence_between_fillers": 3.0, 
    "near_pitch_time": 5, 
    
    # 단조로움 가중치
    "monotone_consecutive_count_limit": 15, 
